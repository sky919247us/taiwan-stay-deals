# 開放資料原始檔太大（約 38MB），每次執行重新下載即可
cache/opendata_hotel.json

# 中繼檔與網頁快照：由 raw/*.json 重跑即可產生，不進版控以免 repo 每週長肥
raw/merged.json
raw/snapshots/

# API 金鑰：絕對不能進公開 repo
cache/google_api_key.txt
cache/openrouter_key.txt
cache/serpapi_key.txt

# robots 快取內容來自第三方網站，可能夾帶對方自己外洩的密鑰，不進版控
cache/robots.json
cache/*_key.txt
.env

__pycache__/
*.pyc
*.tmp
*.bak-*
.DS_Store

# 不小心放進來的無關專案（自己帶 .git，會變成壞掉的 gitlink）
antigravity2-cn/
